<root BTCPP_format="4">

  <BehaviorTree ID="Keypad">
    <Sequence>
      <DriveToPose action_name="/drive_to_pose" x="0.84" y="0.50" yaw="0" angular_tolerance="2"/>
      <DriveToPose action_name="/drive_to_pose" x="0.84" y="0.05" yaw="0" linear_tolerance="0.01" angular_tolerance="2"/>

      <Sequence>
        <Finger service_name="/click" idx="7" action="click"/>
        <Finger service_name="/click" idx="3" action="click"/>
        <Finger service_name="/click" idx="7" action="click"/>
        <Finger service_name="/click" idx="3" action="click"/>
        <Finger service_name="/click" idx="8" action="click"/>
        <Finger service_name="/click" idx="-1" action="click"/>
      </Sequence>

      <RetryUntilSuccessful num_attempts="3">
        <Timeout msec="1000">
          <GetColor color = "{antenna1_color}"/>
        </Timeout>
      </RetryUntilSuccessful>
      <ReportColor service_name="report_lcd" antenna="1" color="{antenna1_color}"/>

      <MapCorrection action_name="/map_correction" x="0.84" y="0.05" yaw="0"/>
      <DriveToPose action_name="/drive_to_pose" x="0.84" y="0.50" yaw="180"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Button">
    <Sequence>
      <DriveToPose action_name="/drive_to_pose" x="0.15" y="0.50" yaw="180"/>
      <DriveToPose action_name="/drive_to_pose" x="0.15" y="0.90" yaw="180"/>

      <Finger service_name="/click" idx="8" action="click"/>
      <Finger service_name="/click" idx="8" action="click"/>
      <Finger service_name="/click" idx="8" action="click"/>
      <Finger service_name="/click" idx="8" action="click"/>
      <Finger service_name="/click" idx="8" action="click"/>

      <RetryUntilSuccessful num_attempts="3">
        <Timeout msec="1000">
          <GetColor action_name="/detect_color" color = "{antenna2_color}"/>
        </Timeout>
      </RetryUntilSuccessful>
      <ReportColor service_name="report_lcd" antenna="2" color="{antenna2_color}"/>
      <DriveToPose action_name="/drive_to_pose" x="0.2" y="0.50" yaw="180"/>

    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="WaitForStart">
    <Parallel success_count="1" failure_count="-1">
      <Start action_name="/start_button"/>
      <Start action_name="/start_light"/>
    </Parallel>
  </BehaviorTree>

  <BehaviorTree ID="Crank">
    <Sequence>
      <!-- Move to crank position -->
      <DriveToPose action_name="/drive_to_pose" x="0.84" y="0.50" yaw="180" angular_tolerance="2"/>
      <DriveToPose action_name="/drive_to_pose" x="0.84" y="0.95" yaw="180" linear_tolerance="0.01" angular_tolerance="2"/>
      <DriveToPose action_name="/drive_to_pose" x="0.84" y="0.95" yaw="180" linear_tolerance="0.01" angular_tolerance="2"/>
      <DriveToPose action_name="/drive_to_pose" x="2.13" y="0.95" yaw="180" linear_tolerance="0.01" angular_tolerance="2"/>
      <DriveToPose action_name="/drive_to_pose" x="2.13" y="0.50" yaw="180" linear_tolerance="0.01" angular_tolerance="2"/>
      <DriveToPose action_name="/drive_to_pose" x="2.28" y="0.50" yaw="180" linear_tolerance="0.01" angular_tolerance="2"/>
      <DriveToPose action_name="/drive_to_pose" x="2.28" y="0.90" yaw="180" linear_tolerance="0.01" angular_tolerance="2"/>

      <Timeout msec="5000">
        <Motor action_name="/crank" velocity="0.5"/>
      </Timeout>

      <Timeout msec="1000">
        <GetColor color = "{antenna3_color}"/>
      </Timeout>
      <ReportColor service_name="report_lcd" antenna="3" color="{antenna3_color}"/>
    </Sequence>
    <!-- Move to next position -->
  </BehaviorTree>

  <BehaviorTree ID="Full">
    <Sequence>
      <SubTree ID="WaitForStart"/>
		  <!-- <Motor action_name="/mast" velocity="0.5"/> -->
      <SubTree ID="Button"/>
      <SubTree ID="Keypad"/>
      <SubTree ID="Crank"/>
    </Sequence>
  </BehaviorTree>

</root>
